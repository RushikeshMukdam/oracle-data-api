# Server Configuration
PORT=5000
NODE_ENV=development

# Optional API Security Key
# Leave blank during local development so no header is required.
# Set a secret key string (e.g. API_KEY=my_secret_token_123) to enforce x-api-key authentication.
API_KEY=

# Oracle Database Credentials
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_CONNECT_STRING=localhost:1521/ORCLPDB1

# Oracle Connection Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=2
DB_POOL_TIMEOUT=60

# Mock Mode Configuration
# Set to 'true' to serve mock data when DB server is unavailable/credentials are pending.
# Set to 'false' to execute live Oracle SQL queries.
USE_MOCK_DATA=true
